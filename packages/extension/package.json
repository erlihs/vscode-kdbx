{
  "name": "kdbx",
  "displayName": "KeePass Database Manager (preview)",
  "version": "0.0.0",
  "private": true,
  "description": "Local KeePass 4.1 database editor preview with encrypted recovery and compatibility diagnostics.",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/erlihs/vscode-kdbx.git"
  },
  "publisher": "erlihs",
  "main": "./dist/extension.js",
  "scripts": {
    "bundle": "node build.mjs",
    "package": "node build.mjs && vsce package --no-dependencies --skip-license --out dist/kdbx.vsix",
    "smoke": "node test/run-smoke.mjs"
  },
  "devDependencies": {
    "@types/vscode": "1.101.0",
    "@vscode-kdbx/core": "workspace:*",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "kdbx.database",
        "displayName": "KeePass Database",
        "selector": [
          {
            "filenamePattern": "*.kdbx"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "kdbx.createDatabase",
        "title": "KeePass: Create Database"
      },
      {
        "command": "kdbx.lockDatabase",
        "title": "KeePass: Lock Database"
      },
      {
        "command": "kdbx.lockAllDatabases",
        "title": "KeePass: Lock All Databases"
      },
      {
        "command": "kdbx.compatibilitySelfTest",
        "title": "KeePass: Run Compatibility Self-Test (synthetic data)"
      }
    ],
    "configuration": {
      "title": "KeePass",
      "properties": {
        "kdbx.idleLockMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 120,
          "scope": "window",
          "description": "Lock after this many minutes without database interaction. Set 0 to explicitly disable idle lock. Dirty changes are encrypted to recovery before locking."
        }
      }
    }
  },
  "extensionKind": [
    "ui"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Database access is disabled in Restricted Mode. The editor only explains the restriction."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Only local filesystem databases in a local desktop window are supported."
    }
  }
}
